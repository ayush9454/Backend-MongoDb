PORT=5050
# Local setup generates a private development secret; deployment requires JWT_SECRET.
# JWT_SECRET=<random secret of at least 32 characters>
JWT_EXPIRES_IN=24h
CORS_ORIGINS=http://localhost:3000
# A replica set or sharded MongoDB is required for transactions.
# MONGO_URI=mongodb://127.0.0.1:27017/parking_system?replicaSet=rs0
# Deployment requires a separate maintenance secret (at least 32 characters).
# MAINTENANCE_SECRET=<random secret>
